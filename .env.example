# ============================================================
# MedTrack — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no repositório
# ============================================================

# Banco de dados PostgreSQL
DB_NAME=medtrack
DB_USER=medtrack_user
DB_PASSWORD=           # Defina uma senha forte

# JWT
JWT_SECRET=            # String aleatória com pelo menos 64 caracteres
JWT_EXPIRATION_MS=86400000   # 24 horas em milissegundos

# SMTP — Gmail
# Para Gmail: ative "Senhas de app" em myaccount.google.com/security
# Para desenvolvimento: use Mailtrap (mailtrap.io) — gratuito
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=         # seu-email@gmail.com
MAIL_PASSWORD=         # senha de app do Gmail (não a senha da conta)

# Admin padrão (criado no seed inicial)
ADMIN_DEFAULT_PASSWORD=  # Troque imediatamente após o primeiro acesso

# openFDA (não requer chave — URL base apenas)
FDA_API_BASE_URL=https://api.fda.gov

# URL base da aplicação (usada em links de e-mail)
APP_BASE_URL=http://localhost:8080
